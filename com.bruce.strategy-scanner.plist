<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <key>Label</key>
    <string>com.bruce.strategy-scanner</string>

    <!-- Script checks NY time internally; exits silently outside 10 AM–2 PM ET -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/jaydensmac/Documents/strategy_scanner.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/jaydensmac/Documents</string>

    <!-- Fire every 30 minutes (1800 seconds) around the clock;
         the script exits immediately outside the NY window -->
    <key>StartInterval</key>
    <integer>1800</integer>

    <key>StandardOutPath</key>
    <string>/Users/jaydensmac/Documents/strategy_scanner.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jaydensmac/Documents/strategy_scanner.err</string>

    <key>RunAtLoad</key>
    <false/>

</dict>
</plist>
